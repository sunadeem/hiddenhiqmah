        android:fillColor="#F8E8C8"
        android:pathData="M 114 122 L 136 122 L 136 130.5 Q 132.5 130.5 131.5 134 L 131.5 174 Q 132.5 177.5 136 177.5 L 136 186 L 114 186 L 114 177.5 Q 117.5 177.5 118.5 174 L 118.5 134 Q 117.5 130.5 114 130.5 Z M 152 122 L 174 122 L 174 130.5 Q 170.5 130.5 169.5 134 L 169.5 174 Q 170.5 177.5 174 177.5 L 174 186 L 152 186 L 152 177.5 Q 155.5 177.5 156.5 174 L 156.5 134 Q 155.5 130.5 152 130.5 Z M 129.5 147.75 L 158.5 147.75 L 158.5 157.25 L 129.5 157.25 Z" />
