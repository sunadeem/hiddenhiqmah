<?xml version="1.0" encoding="utf-8"?>
<!-- Next prayer. Laid out to FILL the slot rather than stack at the top.
     Weighted spacers push the hero (name + countdown) into the vertical centre
     and pin the meta rows to the edges, so a 3x2 cell has no dead band at the
     bottom - the same correction the iOS rectangle needed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top rail: label and city at opposite ends, using the full width. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="NEXT PRAYER"
            android:textColor="#D4A843"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6B665C"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="end" />
    </LinearLayout>

    <!-- Hero, vertically centred in whatever height remains. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Maghrib"
            android:textColor="#F1ECE0"
            android:textSize="26sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Chronometer
            android:id="@+id/widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#D4A843"
            android:textSize="30sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Hairline rail, then the time pinned to the bottom edge.

         ⚠️ ImageView, not View. RemoteViews inflates only a WHITELIST of view
         classes (LinearLayout/FrameLayout/RelativeLayout/GridLayout, TextView,
         ImageView, Button, ImageButton, Chronometer, ProgressBar, ViewFlipper,
         the adapter views...). A plain <View> is NOT on it, and using one makes
         the launcher fail inflation with a bare "Couldn't add widget." - no
         logcat stack, no hint which element was at fault. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="#2A2418"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8D887C"
        android:textSize="13sp"
        android:maxLines="1" />
</LinearLayout>
