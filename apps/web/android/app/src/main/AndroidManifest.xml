<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions.

         POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED, WAKE_LOCK and VIBRATE are
         merged in by @capacitor/local-notifications. Everything below has to be
         declared here, because @capacitor/geolocation and the voice recorder
         declare none of their own. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Prayer times and the qiblah compass. COARSE alone gives times accurate
         to the minute; FINE sharpens the qiblah bearing. Both are requested at
         runtime; the app already works from a cached location without them. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- The adhan has to fire AT the prayer time, not "sometime soon". Without
         this, Android 12+ silently downgrades our alarms to inexact and they
         drift by minutes - which for this app is the whole product failing
         quietly. Denied by default on Android 13+, so the app must check
         checkExactNotificationSetting() and walk the user to the system screen.

         NOT declared: USE_EXACT_ALARM. It is auto-granted with no prompt, but
         Play policy restricts it to apps whose CORE function is alarms, and
         claiming it is a policy argument to have deliberately rather than by
         default. See docs/android-port.md. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Hifz memorisation records the user reciting. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
