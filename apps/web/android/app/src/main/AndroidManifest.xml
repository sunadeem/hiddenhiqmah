<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Notification appearance for FCM pushes.

             Android takes only the ALPHA CHANNEL of a small icon and re-tints
             it, so a full-colour icon becomes a solid white square. Without
             these two lines Firebase falls back to @mipmap/ic_launcher, which
             is opaque edge to edge - every push would show a featureless white
             block where the app mark should be. ic_stat_hiqmah is the mark
             reduced to a flat silhouette for exactly this reason.

             These defaults apply when a message carries a `notification` block,
             which is how every send route builds its payload (lib/push/fcm.ts). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_hiqmah" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/hiqmah_gold" />

        <!-- Which channel a push posts on when the app is BACKGROUNDED and the
             Firebase SDK displays the notification itself (the payload's own
             channel_id only covers the plugin's foreground path).

             Without this, Firebase posts on its own fallback channel, which the
             user sees in Settings as "Miscellaneous" and which is only
             IMPORTANCE_DEFAULT - so android.priority "high" would never produce
             a heads-up banner. The channel is created on first launch by
             ensurePushChannel() in lib/mobile/push.ts; this string, that one,
             and PUSH_CHANNEL_ID in lib/push/fcm.ts must stay identical. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hiqmah_push" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions.

         POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED, WAKE_LOCK and VIBRATE are
         merged in by @capacitor/local-notifications. Everything below has to be
         declared here, because @capacitor/geolocation and the voice recorder
         declare none of their own. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Prayer times and the qiblah compass. COARSE alone gives times accurate
         to the minute; FINE sharpens the qiblah bearing. Both are requested at
         runtime; the app already works from a cached location without them. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- The adhan has to fire AT the prayer time, not "sometime soon". Without
         this, Android 12+ silently downgrades our alarms to inexact and they
         drift by minutes - which for this app is the whole product failing
         quietly. Denied by default on Android 13+, so the app must check
         checkExactNotificationSetting() and walk the user to the system screen.

         USE_EXACT_ALARM covers Android 13+, where it is auto-granted with no
         prompt at all; SCHEDULE_EXACT_ALARM covers 31-32, where it is granted
         by default. Declaring both is Google's documented pairing.

         The policy claim: Play restricts USE_EXACT_ALARM to apps whose core
         function is alarms or calendar events. The adhan IS this app's alarm -
         five fixed times a day computed from the user's location - so the claim
         is a fair one. If Play ever objects, dropping this one line falls back
         to SCHEDULE_EXACT_ALARM alone, and canScheduleExactAlarms() /
         openExactAlarmSettings() in lib/mobile/notifications.ts already exist to
         walk the user through granting it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Audio has to keep sounding once the app is backgrounded. Measured:
         without a foreground service of an audio type, dumpsys reports
         "AudioHardening background playback would be muted for
         com.hiddenhiqmah.app". The adhan sounds at the prayer time - by
         definition a moment nobody is looking at the screen - so this is the
         difference between the app working and failing silently. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Hifz memorisation records the user reciting. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
