# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
#
# UNCOMMENTED DELIBERATELY - this repository is PUBLIC. Capacitor's template
# leaves these commented, i.e. keystores get committed by default, which on a
# public repo would publish the key that signs every release. Anyone holding it
# could sign a package Android would accept as an update to this app.
#
# The upload key is recoverable if lost (Play App Signing lets Google reset it),
# but it is NOT revocable once leaked - so this stays ignored.
*.jks
*.keystore
keystore.properties

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
#
# HELD OUT OF GIT DELIBERATELY - this repository is PUBLIC.
#
# Google's position is that google-services.json is safe to commit: the Firebase
# API key inside it is an identifier, not a secret, and it CANNOT be used to send
# push (sending needs the service-account private key, which lives only in Vercel
# env vars). Capacitor's own template therefore leaves this line commented out.
#
# It is ignored here anyway, because "not a secret" is not the same as "harmless
# in a public repo": an UNRESTRICTED Google Cloud API key can be used by anyone
# against any API enabled on the project and billed to it, and secret scanners
# will flag it regardless. Ignoring costs nothing today - the Android build is
# local-only, with no CI that needs the file.
#
# To commit it instead (needed the moment Android builds move to CI), first
# restrict the key: Google Cloud Console -> Credentials -> the Android key ->
# Application restrictions = Android apps (package com.hiddenhiqmah.app + release
# SHA-1), and API restrictions = only the Firebase APIs in use. Then delete the
# line below. A fresh clone cannot build Android until the file is present.
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
capacitor-cordova-android-plugins

# Copied web assets
app/src/main/assets/public

# Generated Config files
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml
